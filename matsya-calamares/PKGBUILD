# Maintainer: MISTER NEGATIVE <misternegative21@gmail.com>

pkgname=matsya-calamares
_pkgname=calamares
pkgver=3.2.60
pkgrel=3
pkgdesc='Calamares installer framework for MatsyaOS'
arch=('x86_64')
license=('LGPL-2.1-only')
url="https://github.com/calamares/calamares"
depends=('kconfig' 'kcoreaddons' 'kiconthemes' 'ki18n' 'kio' 'solid' 'yaml-cpp'
         'kpmcore>=4.2.0' 'boost-libs' 'ckbcomp' 'hwinfo' 'qt6-svg'
         'polkit-qt6' 'gtk-update-icon-cache' 'plasma-framework'
         'squashfs-tools' 'libpwquality' 'efibootmgr' 'icu')
makedepends=('extra-cmake-modules' 'qt6-tools' 'qt6-translations' 'cmake' 'boost')
backup=('usr/share/calamares/modules/bootloader.conf'
        'usr/share/calamares/modules/displaymanager.conf'
        'usr/share/calamares/modules/initcpio.conf'
        'usr/share/calamares/modules/unpackfs.conf')

source=("$_pkgname-$pkgver::https://github.com/calamares/calamares/releases/download/v$pkgver/$_pkgname-$pkgver.tar.gz"
        "49-nopasswd-calamares.rules")

sha256sums=('9ec6c49f4e2316cd3058d402c2ab65efff02e3f09a0028d50f0359e5154e6c8c'
            '56d85ff6bf860b9559b8c9f997ad9b1002f3fccc782073760eca505e3bddd176')

prepare() {
    cd "$srcdir/$_pkgname-$pkgver"

    sed -i 's/"Install configuration files" OFF/"Install configuration files" ON/' CMakeLists.txt
    sed -i 's/# DEBUG_FILESYSTEMS/DEBUG_FILESYSTEMS/' CMakeLists.txt
    sed -i "s/desired_size = 512 \* 1024 \* 1024  \# 512MiB/desired_size = 512 \* 1024 \* 1024 \* 4  \# 2048MiB/" src/modules/fstab/main.py

    # Matsya branding for desktop file
    sed -i 's#Exec=sh.*#Exec=sh -c "/etc/calamares/launch.sh"#g' calamares.desktop
    sed -i 's#Name=.*#Name=Install Matsya Linux#g' calamares.desktop
    sed -i 's#GenericName=.*#GenericName=System Installer#g' calamares.desktop
    sed -i 's#Icon=.*#Icon=matsya#g' calamares.desktop
    sed -i 's#Comment=.*#Comment=Matsya Linux System Installer#g' calamares.desktop
}

build() {
    cd "$srcdir/$_pkgname-$pkgver"

    cmake -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_PYTHONQT=OFF \
        -DWITH_KF6DBus=OFF \
        -DBoost_NO_BOOST_CMAKE=ON \
        -DWEBVIEW_FORCE_WEBKIT=OFF \
        -DSKIP_MODULES="webview tracking interactiveterminal initramfs \
            initramfscfg dracut dracutlukscfg \
            dummyprocess dummypython dummycpp \
            dummypythonqt services-openrc \
            keyboardq localeq welcomeq"

    cmake --build build -j$(nproc)
}

package() {
    cd "$srcdir/$_pkgname-$pkgver/build"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${srcdir}/49-nopasswd-calamares.rules" "$pkgdir/etc/polkit-1/rules.d/49-nopasswd-calamares.rules"
    chmod 750 "$pkgdir"/etc/polkit-1/rules.d
}
